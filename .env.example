# ── Copy to .env and fill in ──────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000

# MongoDB (Atlas connection string)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# JWT — use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# CORS allow-list (comma separated). Leave empty to use defaults.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend URL (used for password-reset links)
FRONTEND_URL=http://localhost:3000

# ── Optional performance / security tuning ─────────────────────────────────
# Rate limits (requests per 15 min window)
RATE_LIMIT_API_MAX=600
RATE_LIMIT_AUTH_MAX=50
RATE_LIMIT_UPLOAD_MAX=100

# Request logging: set to 1 to log every request; otherwise only slow/errors.
LOG_ALL_REQUESTS=0
# Requests slower than this (ms) are always logged.
LOG_SLOW_MS=300
